# autoBUAA 环境变量示例
# 数据持久化目录（数据库、日志、验证码、自动生成的加密密钥）
AUTOBUAA_DATA_DIR=./data
# Docker Compose 对外端口
AUTOBUAA_PORT=8080
# 日志级别 (DEBUG / INFO / WARNING / ERROR)
AUTOBUAA_LOG_LEVEL=DEBUG
# 可选：自定义主加密密钥文件路径（默认 <DATA_DIR>/secret.key）
# AUTOBUAA_SECRET_KEY_FILE=/data/secret.key
# 可选：Cookie Secure 属性（仅在 HTTPS 反向代理下设为 true）
AUTOBUAA_COOKIE_SECURE=false
